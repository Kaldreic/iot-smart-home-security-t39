 	conn_update_ind.interval = interval;
 }
 
+/* PARAMETERIZABLE SUBSET ORACLE. The benchmark "window" is a fixed sequence of LL control
+ * PDUs sent to an established peripheral; HARNESS_SUBSET (decimal bitmask, bit i => include window[i])
+ * selects which are injected, in order. window[0..2] = LL_LE_PING_REQ / LL_VERSION_IND /
+ * LL_FEATURE_REQ (transparent decoys); window[3] = the malformed LL_CONNECTION_UPDATE_IND(interval=0)
+ * trigger. We pump to the instant, where the unguarded controller divides by interval -> SIGFPE iff
+ * window[3] is set. The oracle (oracle.py) keys on the SIGFPE (subprocess returncode -8). Deterministic. */
+ZTEST(periph_rem_invalid, test_oracle)
+{
+	const char *s = getenv("HARNESS_SUBSET");
+	unsigned long mask = s ? strtoul(s, NULL, 0) : 0UL;
+	uint16_t saved = conn_update_ind.interval;
+	uint16_t instant = 0;
+	bool have_update = false;
+
+	/* benign-decoy params: version=window[1], feature=window[2]; window[3] = the CVE trigger */
+	struct pdu_data_llctrl_version_ind ver = { .version_number = 0x0C,
+		.company_id = 0x05F1U, .sub_version_number = 0x0000U };
+	struct pdu_data_llctrl_feature_req feat = { .features = { 0xFFU, 0, 0, 0, 0, 0, 0, 0 } };
+
+	test_set_role(&conn, BT_HCI_ROLE_PERIPHERAL);
+	ull_cp_state_set(&conn, ULL_CP_CONNECTED);
+
+	/* NOTE: LL_LENGTH_REQ was dropped -- it is NOT a transparent decoy. A pending Data-Length
+	 * procedure collides with / defers the conn-update so the trigger no longer applies (a REAL
+	 * LLCP procedure-collision => genuine non-monotonicity; a candidate "suppressor" variant, not
+	 * used in this clean window). ping/version/feature ARE transparent (verified exhaustively). */
+#define INJECT(bit, op, param) do { if (mask & (bit)) {                \
+		event_prepare(&conn); lt_tx(op, &conn, param); event_done(&conn); \
+		event_prepare(&conn); event_done(&conn); /* let the procedure settle */ } } while (0)
+	INJECT(0x01U, LL_LE_PING_REQ, NULL);      /* window[0] */
+	INJECT(0x02U, LL_VERSION_IND, &ver);      /* window[1] */
+	INJECT(0x04U, LL_FEATURE_REQ, &feat);     /* window[2] */
+#undef INJECT
+
+	if (mask & 0x08U) {                          /* window[3]: the CVE trigger */
+		event_prepare(&conn);
+		conn_update_ind.interval = 0U;
+		conn_update_ind.instant = event_counter(&conn) + 6U;
+		instant = conn_update_ind.instant;
+		lt_tx(LL_CONNECTION_UPDATE_IND, &conn, &conn_update_ind);
+		event_done(&conn);
+		have_update = true;
+	}
+	if (have_update) {
+		while (!is_instant_reached(&conn, instant)) {
+			event_prepare(&conn);
+			event_done(&conn);
+		}
+		event_prepare(&conn);
+		event_done(&conn);                  /* apply at instant -> div0 iff interval==0 */
+	}
+	conn_update_ind.interval = saved;
+}
+
 #if defined(CONFIG_BT_CTLR_CONN_PARAM_REQ)
