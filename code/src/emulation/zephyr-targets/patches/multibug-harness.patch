--- a/tests/bluetooth/controller/ctrl_conn_update/src/main.c
+++ b/tests/bluetooth/controller/ctrl_conn_update/src/main.c
@@ -4906,6 +4906,234 @@ ZTEST(periph_rem_invalid, test_conn_update_periph_rem_invalid_param)
